# Copia este archivo como .env y rellena tus claves
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)

# Google Gemini API Key (requerida)
# Obtén la tuya en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=TU_API_KEY_AQUI

# OpenAI (opcional — fallback provider)
# OPENAI_API_KEY=sk-...

# Anthropic Claude (opcional — fallback provider)
# ANTHROPIC_API_KEY=sk-ant-...
